#!/bin/bash
#SBATCH --job-name=GPD_P2B_CPU_profile
#SBATCH --partition=REPLACE_WITH_VERIFIED_CPU_PARTITION
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=01:00:00
#SBATCH --account=REPLACE_WITH_VERIFIED_CPU_ACCOUNT
#SBATCH --output=GPD_P2B_CPU_profile-%j.out
#SBATCH --error=GPD_P2B_CPU_profile-%j.err
set -euo pipefail
P2B_PYTHON=REPLACE_WITH_REFERENCE_COMPATIBLE_PYTHON
P2B_PROFILE_DRIVER=REPLACE_WITH_IMPLEMENTED_FULL_PIPELINE_PROFILE_DRIVER
P2B_PACKAGE=REPLACE_WITH_V3_PACKAGE_PATH
P2B_CAPSULE=REPLACE_WITH_EXISTING_P1_CAPSULE
P2B_OUTPUT=REPLACE_WITH_NEW_PROFILE_OUTPUT
for P2B_VALUE in "$P2B_PYTHON" "$P2B_PROFILE_DRIVER" "$P2B_PACKAGE" "$P2B_CAPSULE" "$P2B_OUTPUT"; do
  if [[ "$P2B_VALUE" == REPLACE_* ]]; then exit 2; fi
done
test -f "$P2B_PROFILE_DRIVER"
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
"$P2B_PYTHON" "$P2B_PACKAGE/verify_package.py"
# Driver measures one-thread reference and eight-thread/cache candidate on the
# same allocated node. It must apply threadpool limits after legacy imports.
srun --cpu-bind=cores "$P2B_PYTHON" -B "$P2B_PROFILE_DRIVER" \
  --packet "$P2B_PACKAGE" --capsule "$P2B_CAPSULE" --backend cpu_compare \
  --threads 8 --max-diagnostic-steps 4 --out "$P2B_OUTPUT"
